# Telegram (backend/notifications/telegram.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Angel One SmartAPI (backend/brokers/angel_one.py)
# ANGEL_ONE_TOTP_SECRET is the base32 secret from the QR code shown when
# enabling TOTP at https://smartapi.angelbroking.com/enable-totp - not
# a 6-digit code itself, pyotp derives the current code from this secret.
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# docker-compose.yml (24/7 deployment) - which instrument the `live`
# service watches. SYMBOL_TOKEN is Angel One's numeric token for that
# instrument's index/future, not the trading symbol string - look it up
# from Angel One's published scrip master before deploying.
INSTRUMENT=NIFTY
EXCHANGE=NSE
SYMBOL_TOKEN=
INTERVAL=FIVE_MINUTE
POLL_SECONDS=60

# CORS: the origin(s) the frontend will be served from, comma-separated.
# Set this to your deployed frontend's real URL (e.g. a Vercel domain).
CORS_ALLOWED_ORIGINS=http://localhost:3000
